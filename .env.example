# Copy this file to .env and fill in real values. Never commit .env itself
# (see .gitignore). Any value left blank runs against the mock for that
# service instead of failing - see README.md.

# --- Anthropic (the 5 agents' reasoning, and the web search tool) ---
# Verified usage: docs/SOURCES.md "Anthropic (Claude)".
ANTHROPIC_API_KEY=
# Any valid Claude model string. Defaults to claude-sonnet-5-5 per project spec.
CLAUDE_MODEL=claude-sonnet-5-5

# --- Gemini (marketing copy only, since 2026-10-18 - NOT agent reasoning) ---
# Verified usage: docs/SOURCES.md "Gemini agent reasoning" and "Groq and
# Gemini are separate roles now, never mixed". Get a free key (no payment
# method required) from https://aistudio.google.com -> API keys. Owner's
# instruction, 2026-10-18 ("اترك groq يشتغل كل شيء لوحده و جيميني يبحث على
# التسويق"): Gemini writes the marketing post copy for a just-published
# product (workflows/marketing.py) - it is no longer in the agent's own
# decision-reasoning chain at all (Groq/SambaNova below cover that). If
# Groq is not configured, Gemini still covers agent reasoning standalone
# as a last resort (see build_app() in src/app.py).
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- Groq (runs the single agent's own decision reasoning) ---
# Verified usage: docs/SOURCES.md "Groq fallback" and "Groq and Gemini are
# separate roles now, never mixed". Get a free key from
# https://console.groq.com -> API Keys. Owner's instruction, 2026-10-18:
# Groq runs the agent's own reasoning alone - Gemini below is NOT its
# fallback any more (see GEMINI_API_KEY's own comment), SambaNova is.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- SambaNova (Groq's own fallback for agent decision reasoning) ---
# Verified usage: docs/SOURCES.md "Groq and Gemini are separate roles now,
# never mixed". Owner's instruction, 2026-10-18 ("اذا كان يجب ان نضيف اخر
# مع groq نبحث على المجاني"): added after Groq's real account-wide quota
# exhaustion. Get a free key (no card) from cloud.sambanova.ai -> API
# Keys. If Groq is not configured but SambaNova is, SambaNova runs
# standalone instead.
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# --- Shopify (your store) ---
# Verified usage: docs/SOURCES.md "Shopify". Every RealShopifyClient method
# is real and verified. Authentication uses the Client credentials grant
# (see docs/SOURCES.md "Shopify > Client credentials access token") - the
# app exchanges SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET for a short-lived
# access token itself, no manually-obtained static token needed. Get both
# from your store's Dev Dashboard -> your app -> App settings -> Credentials.
SHOPIFY_SHOP_URL=your-shop.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2024-07

# --- CJ Dropshipping (your supplier) ---
# Authentication is verified - see docs/SOURCES.md "CJ Dropshipping >
# Authentication". Every data method (search, pricing, orders, tracking) is
# still NOT verified - docs/UNVERIFIED.md - and still raises
# NotImplementedError until confirmed. Get CJ_API_KEY from your CJ dashboard:
# Apps -> install "API" app -> API tab -> Add API -> Type: API Key -> copy it.
CJ_API_KEY=
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# --- Telegram (your approval channel) ---
# Verified usage: docs/SOURCES.md "Telegram". Message your bot once first so
# it can see your chat - see README.md step for getting TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Marketing (promotes a real published product automatically) ---
# Owner's instruction, 2026-10-18 ("ابحث انت و قرر الافضل"): see
# docs/SOURCES.md "Marketing - real platform research" for why these three
# platforms specifically (free, no lengthy approval for your own account)
# and not X/Twitter (now pay-per-post) or Pinterest (needs Pinterest's own
# manual review first). Each platform is fully independent and optional -
# leave any of them blank to skip it, nothing else breaks.

# Telegram: a PUBLIC channel, different from TELEGRAM_CHAT_ID above (your
# private approval chat) - add your bot as an admin of the channel first.
TELEGRAM_MARKETING_CHANNEL_ID=

# Facebook Page + Instagram share one Meta access token. Get both from
# developers.facebook.com -> your app -> a Page you own/manage needs only
# Standard Access, not App Review (Meta's own docs, 2026-06).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Safety limits (src/tools/limits.py) ---
# Owner's explicit instruction, 2026-10-14: MAX_ORDER_COST/DAILY_SPEND_LIMIT
# are removed entirely - a CJ_ORDER proposal is only ever created from a
# Shopify order already reported as paid (financial_status=paid), so there
# is no spending cap any more; the money is always the customer's own
# payment, never the owner's at risk. MIN_MARGIN is no longer an
# auto-reject floor either - only a real, fee-inclusive profit of zero or
# less is rejected (see check_margin() in src/tools/limits.py). MIN_MARGIN
# itself survives only as price_inventory_review.py's own repricing target
# (the margin it reprices TO after a supplier price change), not a gate.
MIN_MARGIN=0.25

# --- Mode ---
# true = no real purchase, no real publish, no real customer message -
# everything only logged. Telegram approval messages to YOU still send for
# real, since that is the approval mechanism itself, not a side effect.
# Set to false only once you are ready for real spend - see README.md.
DRY_RUN=true

# --- Misc ---
DATABASE_PATH=./nexus_commerce.db
# Minutes between scheduler runs of the hourly jobs (orders/tracking/prices).
HOURLY_INTERVAL_MINUTES=10
LOG_LEVEL=INFO
