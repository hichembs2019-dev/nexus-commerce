# Copy this file to .env and fill in real values. Never commit .env itself
# (see .gitignore). Any value left blank runs against the mock for that
# service instead of failing - see README.md.

# --- Anthropic (the 5 agents' reasoning) ---
# Verified usage: docs/SOURCES.md "Anthropic (Claude)".
ANTHROPIC_API_KEY=
# Any valid Claude model string. Defaults to claude-sonnet-5-5 per project spec.
CLAUDE_MODEL=claude-sonnet-5-5

# --- Shopify (your store) ---
# Verified usage: docs/SOURCES.md "Shopify". The GraphQL query/mutation
# bodies themselves are NOT verified - see docs/UNVERIFIED.md. Until that is
# finished, RealShopifyClient raises NotImplementedError for product/price/
# fulfillment writes; reading orders for financial_status also needs that
# work finished.
SHOPIFY_SHOP_URL=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-07

# --- CJ Dropshipping (your supplier) ---
# NOT verified at all - docs/UNVERIFIED.md. RealCJClient raises
# NotImplementedError for every method until this is filled in by hand once
# developers.cjdropshipping.com is reachable.
CJ_API_KEY=
CJ_API_BASE_URL=

# --- Telegram (your approval channel) ---
# Verified usage: docs/SOURCES.md "Telegram". Message your bot once first so
# it can see your chat - see README.md step for getting TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Safety limits (spec requirement - enforced in src/tools/limits.py) ---
# Any single proposed order above this cost is auto-rejected before the
# 5 agents even see it.
MAX_ORDER_COST=200
# Running total of same-day approved spend above this is auto-rejected.
DAILY_SPEND_LIMIT=500
# A new-product proposal with a lower profit margin than this (0.0-1.0) is
# auto-rejected before the 5 agents see it.
MIN_MARGIN=0.25

# --- Mode ---
# true = no real purchase, no real publish, no real customer message -
# everything only logged. Telegram approval messages to YOU still send for
# real, since that is the approval mechanism itself, not a side effect.
# Set to false only once you are ready for real spend - see README.md.
DRY_RUN=true

# --- Misc ---
DATABASE_PATH=./nexus_commerce.db
# Minutes between scheduler runs of the hourly jobs (orders/tracking/prices).
HOURLY_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
